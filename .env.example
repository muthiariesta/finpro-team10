# Salin berkas ini menjadi .env.local lalu isi nilainya.
# Next.js membaca .env.local saat dev server MULAI - restart setiap kali diubah.

# Wajib. Tanpa ini halaman /report dan /emergency gagal dimuat.
# Ambil dari Vercel > Storage > Postgres/Neon > .env.local
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Wajib untuk Safe Route. Tanpa ini frontend menembak localhost:8000.
NEXT_PUBLIC_RISK_API_URL="https://riskscore-api.onrender.com"

# Opsional. Tanpa ini unggah bukti pada laporan gagal (submit tanpa berkas
# tetap berhasil). Ambil dari Vercel > Storage > Blob.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Opsional. Tanpa ini pengiriman SOS dilaporkan sebagai simulasi.
FONNTE_TOKEN=""
