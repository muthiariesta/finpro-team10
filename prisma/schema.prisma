// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  name         String
  /// Bisa berupa surel atau nomor telepon; disimpan dalam huruf kecil
  /// supaya pencarian saat masuk tidak peka besar-kecil huruf.
  identifier   String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
}

/// Perjalanan sebuah laporan sejak dikirim sampai diputuskan admin.
///
/// PENDING adalah keadaan awal. Hanya laporan VERIFIED yang boleh muncul di
/// feed publik: laporan yang belum diperiksa tidak boleh ikut membentuk
/// persepsi orang tentang suatu wilayah.
enum ReportStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Incident {
  id          String       @id @default(cuid())
  category    String
  location    String
  timestamp   DateTime
  description String?
  /// Lampiran pertama. Dipertahankan supaya laporan lama tetap terbaca;
  /// laporan baru mengisi evidenceUrls dan menyalin yang pertama ke sini.
  evidenceUrl String?
  /// Semua lampiran. Satu kejadian sering perlu beberapa foto - wajah
  /// pelaku, pelat nomor, dan keadaan sekitar jarang muat dalam satu bingkai.
  evidenceUrls String[] @default([])
  /// Koordinat kejadian bila pelapor bersedia menyertakannya. Opsional:
  /// memaksakannya akan menghalangi orang yang justru paling perlu melapor.
  lat            Float?
  lon            Float?
  /// "gps" | "map" | "manual". Admin perlu tahu asal koordinatnya sebelum
  /// memercayainya - titik GPS dan titik yang ditaruh dengan tangan punya
  /// tingkat ketelitian yang jauh berbeda.
  locationSource String?
  ownerToken  String
  status      ReportStatus @default(PENDING)
  /// Tanggapan admin yang terlihat oleh pelapor; menjawab keluhan riset
  /// bahwa laporan terasa hilang begitu saja setelah dikirim.
  adminNote   String?
  reviewedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([status])
}

/// Kategori tempat aman yang didaftarkan admin.
enum SafePointType {
  MEDICAL
  POLICE
  COMMERCIAL
}

/// Safe point kurasi admin.
///
/// Melengkapi hasil OpenStreetMap, bukan menggantikannya. OSM luas tapi jam
/// bukanya sering usang; daftar ini memuat tempat yang sudah dipastikan
/// benar-benar buka dan bisa dituju.
model SafePointEntry {
  id        String        @id @default(cuid())
  name      String
  type      SafePointType
  location  String
  phone     String?
  /// Koordinat opsional. Tanpa ini tempatnya tetap tampil di daftar admin,
  /// hanya tidak bisa digambar di peta.
  lat       Float?
  lon       Float?
  createdAt DateTime      @default(now())
}

enum AreaRiskLevel {
  LOW
  MEDIUM
  HIGH
  LIMITED
}

/// Penilaian risiko wilayah yang ditetapkan admin.
///
/// Inilah jawaban atas keterbatasan terbesar produk: model dilatih dengan
/// dataset Chicago, sehingga seluruh Indonesia mengembalikan "tidak ada
/// data". Dengan tabel ini, admin bisa menilai ruas jalan setempat secara
/// manual, dan penilaian itu dipakai ketika model tidak punya jawaban.
model RiskArea {
  id            String        @id @default(cuid())
  areaName      String
  streetSegment String
  crowdDensity  String
  riskLevel     AreaRiskLevel @default(LIMITED)
  lat           Float
  lon           Float
  /// Jangkauan pengaruh penilaian ini terhadap titik di sekitarnya.
  radiusM       Int           @default(500)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

/// Kontak darurat milik satu perangkat.
///
/// Tidak ada akun pengguna di MVP ini, jadi kepemilikan ditandai dengan
/// ownerToken yang disimpan di localStorage - pola yang sama dengan laporan
/// anonim. Tanpa itu, nomor telepon orang terdekat akan terlihat oleh semua
/// pengunjung aplikasi.
model Guardian {
  id         String   @id @default(cuid())
  name       String
  role       String
  phone      String
  isPrimary  Boolean  @default(false)
  channels   String[]
  ownerToken String
  createdAt  DateTime @default(now())

  @@index([ownerToken])
}
